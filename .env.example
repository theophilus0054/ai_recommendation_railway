# Salin menjadi .env untuk lokal, atau isi di Railway > service > Variables. Jangan commit .env asli.

# WAJIB: kunci yang dikirim NutriScale di header X-API-Key (sama dengan AI_ENGINE_API_KEY di .env NutriScale)
AI_ENGINE_API_KEY=

# WAJIB: URL web NutriScale; katalog produk diambil dari <URL>/api/products saat startup dan /api/sync
NEXT_PUBLIC_APP_URL=https://nutriscale-anda.vercel.app
# PRODUCTS_FETCH_TIMEOUT=10   # detik menunggu /api/products (Vercel bisa cold start)

# Cadangan sumber katalog bila /api/products gagal (opsional, pilih salah satu)
# DATABASE_URL=postgresql://...
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# LLM (opsional; tanpa kunci, engine tetap jalan memakai regex + template narasi)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL_CADANGAN=gemini-3.1-flash-lite   # dipakai bila model utama 503/429/404
GEMINI_TIMEOUT_DETIK=10   # minimum 10 (batas Gemini API)
GROQ_API_KEY=
# ALLERGY_LLM_TIMEOUT=3

# Keamanan & operasional (opsional)
# ALLOWED_ORIGINS=https://nutriscale-anda.vercel.app   # kosong = tidak ada akses browser langsung (disarankan)
# AI_DOCS_ENABLED=0                                     # sembunyikan /docs di produksi
# RATE_LIMIT_RECOMMEND=20/minute
# RATE_LIMIT_SYNC=10/minute

# Hanya dev/test offline: pakai snapshot data/supabase_products.json bila katalog tidak bisa diambil
# AI_ALLOW_SNAPSHOT_FALLBACK=1
